{
  "id" : "wide-record-210-fields-under-one-parent",
  "family" : "limits",
  "title" : "A 210-field record under a single parent round-trips exactly",
  "stack" : "BOTH",
  "referenceIssue" : "",
  "rationale" : "The hundreds-of-fields leg, aimed at the reconstruction side. analyzeStructure groups every key under every prefix and then scans all collected values for array-likeness, so one wide parent produces one prefix carrying 210 values. This is the shape that made reconstruction quadratic before NP-021.",
  "catchesBugClass" : "Superlinear behaviour in prefix grouping, key collisions from the sanitizer at scale, and any silent field-count cap below 210. Also catches array misinference triggered by volume rather than content.",
  "cannotCatch" : "All keys are 2 segments and all values are Integers, so it exercises the cheapest path: it cannot catch depth-times-width blowup and it cannot catch value-driven inference cost.",
  "predicted" : {
    "classification" : "LOSSLESS",
    "detail" : "Every value fails the String check so no array inference runs and the record rebuilds field-for-field."
  },
  "configDescription" : "defaults (210 < maxMapSize 10000)",
  "config" : { },
