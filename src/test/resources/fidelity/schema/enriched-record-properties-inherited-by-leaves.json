    "enrichedCompare" : "PROPERTY_SET",
    "enrichedOptions" : "separator=_;arrayBoundarySeparator=__;inheritDoc=true;inheritRecordProperties=false;unwrapNullableUnions=true;collisionPolicy=FAIL;maxDepth=64;maxFields=100000;injected=[]",
    "propertyPlacement" : "{\"customer.full_name\":\"S:[x-chase-dataelem]\",\"order_id\":\"S:[x-chase-dataelem, x-erwin-physical-type]\"}",
    "flat" : "{\"customer_full\\\\_name\":\"S:A B\",\"order\\\\_id\":\"S:o-1\"}",
    "avroBaseline" : "x-chase-dataelem=DE-1001 x-chase-dataelem=DE-2001 x-erwin-physical-type=VARCHAR(36) x-owner=payments",
    "avroDoc" : "x-chase-dataelem=DE-1001 x-chase-dataelem=DE-2001 x-erwin-physical-type=VARCHAR(36)",
    "losslessAvro" : false,
    "probe" : {
      "kind" : "ENRICHED_CONFIG_COMPARE",
      "expect" : "DIFFERENT",
      "a" : "{\"customer_full_name\":\"S:doc=null;docInherited=false;mappedType=VARCHAR;props={x-chase-dataelem=DE-2001, x-owner=payments};nullable=false;withinArray=false;position=2\",\"order_id\":\"S:doc=null;docInherited=false;mappedType=VARCHAR;props={x-chase-dataelem=DE-1001, x-erwin-physical-type=VARCHAR(36)};nullable=false;withinArray=false;position=1\"}",
