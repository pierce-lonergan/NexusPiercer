{
  "id" : "vd-integer-boundaries-within-long",
  "family" : "value-domain",
  "title" : "Every integer boundary up to Long.MAX_VALUE survives with its exact type",
  "stack" : "BOTH",
  "referenceIssue" : "",
  "rationale" : "ValueDomainContractTest asserts one long past 2^53 at the Map level only and explicitly defers the JSON-parsing path. This is that path. It walks the full ladder through the JSON stack, where Jackson untyped deserializer picks Integer, Long or BigInteger by magnitude - a silent contract nothing in the library asserts.",
  "catchesBugClass" : "Any widening of an integral value to double anywhere in the pipeline - the classic 2^53 corruption that produces a plausible, wrong, off-by-one number. Also catches a change of numeric runtime class if the oracle is class-strict.",
  "cannotCatch" : "Stops one value short of the real cliff. It also never reaches JsonReconstructor.parseAtomicValue, which re-narrows any long in int range back to int; that path only runs under the delimiter formats.",
  "predicted" : {
    "classification" : "LOSSLESS",
    "detail" : "Jackson yields Integer for the small values and Long for the rest; normalizePrimitive returns any Number untouched, so 9007199254740993 comes back exactly."
  },
