target/
!.mvn/wrapper/maven-wrapper.jar

### Locally-downloaded jars ###
# 16MB of hand-downloaded jars live here on at least one workstation — they were Groovy
# 5.0.0 runtime jars, left over from before the Groovy toolchain was removed on 2026-08-11.
# Maven owns dependency resolution; nothing in the build has ever read this directory.
# Ignored so a stray `git add -A` cannot write binaries into the permanent history of a
# published repository.
lib/

### Agent-harness scratch ###
# .claude/worktrees holds full working copies of this repository, target/ trees included.
# Same hazard as lib/ above: one careless `git add -A` writes a nested duplicate of the
# whole project into permanent history. Nothing in the build reads it.
.claude/

### Benchmark output ###
benchmarks/results/*.json
!benchmarks/results/baseline.json
benchmarks/target/

### jqwik ###
# Records which property tests previously failed, so failing samples are retried first.
# Machine-local state, not shared history.
.jqwik-database
!**/src/main/**/target/
!**/src/test/**/target/

