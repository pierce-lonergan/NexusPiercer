<?xml version="1.0" encoding="UTF-8"?>
<!--
  JMH benchmark harness for NexusPiercer.

  DELIBERATELY A STANDALONE PROJECT, not a module of the library reactor.

  One reason now, where there used to be two:

  1. It measures the shipped bytecode. This project depends on the library ARTIFACT, so JMH runs
     against exactly what Maven Central receives — not a recompilation under different flags.

  2. EXPIRED 2026-08-11. The original first reason was annotation processing vs. joint
     compilation: JMH generates its harness with an annotation processor, and the library module
     interleaved maven-compiler-plugin with a five-execution gmavenplus lifecycle
     (addSources -> generateStubs -> compile, then the test equivalents), so a processor there
     would have seen a source tree containing generated Java stubs for the Groovy classes.
     The Groovy toolchain was removed; that lifecycle no longer exists. Reason 1 is now carrying
     the separation on its own — see benchmarks/README.md.

  Build the library first (`./mvnw install` in the parent directory), then:

      mvn -f benchmarks/pom.xml package
      java -jar benchmarks/target/benchmarks.jar -f 3 -wi 5 -i 10 -prof gc -rf json -rff results.json
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.pierce-lonergan</groupId>
    <artifactId>nexus-piercer-benchmarks</artifactId>
    <version>2.1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>NexusPiercer Benchmarks</name>
    <description>JMH benchmark harness. Never published.</description>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <jmh.version>1.37</jmh.version>
        <uberjar.name>benchmarks</uberjar.name>
        <!-- This project is a measurement tool; it must never reach a repository. -->
        <maven.deploy.skip>true</maven.deploy.skip>
        <maven.install.skip>true</maven.install.skip>
        <gpg.skip>true</gpg.skip>
    </properties>

    <dependencies>
        <!--
          MUST track the root pom's <version> exactly. benchmark.yml installs the root artifact and
          then builds this module against it, so that the harness measures the bytecode that ships
          rather than a stale jar. If this drifts, a fresh CI runner cannot resolve it and a local
          run silently measures whatever old snapshot survives in ~/.m2 - which is worse, because
          it still produces numbers. The workflow asserts the two agree; see benchmark.yml.
        -->
        <dependency>
            <groupId>io.github.pierce-lonergan</groupId>
            <artifactId>nexus-piercer</artifactId>
            <version>2.1.0-SNAPSHOT</version>
        </dependency>

        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-core</artifactId>
            <version>${jmh.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-generator-annprocess</artifactId>
            <version>${jmh.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>${uberjar.name}</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <!--
                      Declared explicitly rather than relying on classpath discovery. Newer JDKs
                      default to -proc:none, under which classpath-discovered processors silently
                      do nothing — and a JMH build with no processor produces a jar containing
                      zero benchmarks that still exits 0.
                    -->
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.openjdk.jmh</groupId>
                            <artifactId>jmh-generator-annprocess</artifactId>
                            <version>${jmh.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <finalName>${uberjar.name}</finalName>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>org.openjdk.jmh.Main</mainClass>
                                </transformer>
                                <!--
                                  REQUIRED. JMH stores its benchmark inventory in
                                  META-INF/BenchmarkList and META-INF/CompilerHints. Without
                                  service/resource merging the uber-jar finds zero benchmarks and
                                  reports "No matching benchmarks" while exiting successfully.
                                -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                                    <resource>META-INF/BenchmarkList</resource>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                                    <resource>META-INF/CompilerHints</resource>
                                </transformer>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
